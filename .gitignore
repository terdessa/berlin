.DS_Store
.vscode/
.claude/

# Dependencies and build artifacts (any depth)
**/node_modules/
ui/dist/
ui/.wrangler/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local env files - never commit credentials/secrets
.env
.env.*
!.env.example

# Superseded scratch folders kept around locally only
Test Live/
Test Video Live/
Test Audio Live/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/

# Audio corpus files (large binaries — share folder separately)
apps/voice/submission/audio/raw/*.wav
apps/voice/submission/audio/enhanced/*.wav
