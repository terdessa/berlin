{
  "metric": {
    "name": "Sentinel Audio Intelligence Score",
    "shortName": "SAIS",
    "version": "0.2",
    "definition": "Task-conditioned composite metric: SAIS = 0.5\u00b7CommandFidelity + 0.3\u00b7TimeToCorrectAction + 0.2\u00b7SafeRecoveryRate. Each component is a per-record ratio in [0, 1] aggregated across the corpus. Generic audio quality (NISQA) is reported alongside as a reference signal.",
    "components": {
      "CF": "Command Fidelity = 1 \u2212 WER on the parsed transcript.",
      "TTCA": "Time-to-Correct-Action = 1 if the action ran on the first try, 0.5 if a safe clarification recovered the turn, 0 otherwise.",
      "SRR": "Safe Recovery Rate = safe_failures / total_failures (1.0 if no failures)."
    },
    "weights": {
      "CF": 0.5,
      "TTCA": 0.3,
      "SRR": 0.2
    }
  },
