# Copy this file to `.env` and fill in your LiveKit Cloud credentials.
# Get free credentials at https://cloud.livekit.io (no card required for the free tier).
#
# These are server-side secrets — they are read by `src/lib/livekit-token.ts`
# at request time. They MUST NOT be prefixed with VITE_ or they would leak to
# the client bundle.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=replace-with-the-long-secret-from-livekit-cloud

# Server-side Gemini key for /gemini-preview. Do not prefix with VITE_.
# Create a key in Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional. Defaults to Gemini 3.1 Pro Preview for frame-based camera analysis.
GEMINI_CAMERA_MODEL=gemini-3.1-pro-preview

# Optional fallback used when the preferred model is out of quota or unavailable.
GEMINI_CAMERA_FALLBACK_MODEL=gemini-2.5-flash-lite
