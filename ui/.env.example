# Copy this file to `.env` and fill in your LiveKit Cloud credentials.
# Get free credentials at https://cloud.livekit.io (no card required for the free tier).
#
# These are server-side secrets — they are read by `src/lib/livekit-token.ts`
# at request time. They MUST NOT be prefixed with VITE_ or they would leak to
# the client bundle.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=replace-with-the-long-secret-from-livekit-cloud
