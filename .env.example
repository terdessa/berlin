# Root runtime credentials for the Sentinel voice worker.
# Copy this file to `.env` at the repository root and fill in real values.
# Never commit `.env`.

LIVEKIT_URL=wss://berlin-vc00ggsm.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Optional; defaults to sentinel-live.
LIVEKIT_ROOM=sentinel-live

# Must match the identity used by the UI `/audio` publisher unless both sides
# are intentionally changed together.
LIVEKIT_MIC_IDENTITY=sentinel-guard-mic

# ai-coustics enhancement.
AICOUSTICS_API_KEY=eyJ1c2VyIjoidXNlcl8zQ3FOQ0g0TnlyNGVJb3hnVXU2bUxPaTZiYngiLCJ2ZXJzaW9uIjoiMiIsImFwaV9rZXkiOiI4NzBmMmJiMWFkMGNmYzg4Zjk5Mjk0MDZiY2ZlZjI1YTQ2MWI4YTFmNjYzZDE1MzExOGIzOGEyNjZjNjExZmFlIn0=.

# Voice runtime. Gradium/telli is preferred when available; OpenAI is the
# current fallback for STT/TTS and dataset transcription.
TELLI_API_KEY=replace-with-telli-api-key
GRADIUM_API_KEY=replace-with-gradium-or-telli-api-key
GRADIUM_VOICE_ID=
OPENAI_API_KEY=replace-with-openai-api-key

# Gemini camera analysis for the dashboard CAM-03 watcher and /gemini-preview.
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_CAMERA_MODEL=gemini-2.5-flash-lite
GEMINI_CAMERA_FALLBACK_MODEL=gemini-3.1-pro-preview
